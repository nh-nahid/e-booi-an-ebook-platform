# Copy this file to .env.local (local) or set the values in Vercel -> Settings -> Environment Variables.

# Backend API base URL (must end with /api/v1).
#   local : http://localhost:5000/api/v1
#   live  : https://<your-backend>.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

NEXT_PUBLIC_APP_NAME=ebooi

# Backend origin WITHOUT /api/v1. The website proxies the EPS payment callbacks
# (/api/v1/payment/eps/*) to it. Falls back to NEXT_PUBLIC_API_URL when empty.
BACKEND_ORIGIN=http://localhost:5000

# Google sign-in: the OAuth "Web application" Client ID (the secret goes ONLY in the
# backend). Leave empty to hide the Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Link for the "Android app download" button in the footer (EAS build page,
# later the Play Store). Leave empty to use the built-in default.
NEXT_PUBLIC_APP_DOWNLOAD_URL=
