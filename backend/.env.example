# Application
APP_NAME=eBooi
PORT=5000
NODE_ENV=development

# URLs (no trailing slash)
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Database
MONGO_CONNECTION_STRING=

# JWT & Cookies
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
COOKIE_NAME=
COOKIE_SECRET=

# Cloudinary (book covers, PDFs, avatars)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# EPS (Easy Payment System) — sandbox values come from the EPS credentials
# document. For live, change EPS_BASE_URL and use the live credentials.
EPS_BASE_URL=https://sandboxpgapi.eps.com.bd
EPS_USERNAME=
EPS_PASSWORD=
EPS_HASH_KEY=
EPS_STORE_ID=
# Optional — only if EPS gave you a separate merchant id
EPS_MERCHANT_ID=
# Guide table says 1 = Web; the guide's sample body uses 10. Change if EPS rejects 1.
EPS_TRANSACTION_TYPE_ID=1

# Email (Gmail SMTP)
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Password reset
RESET_PASSWORD_EXPIRE=

# Admin
ADMIN_ACCESS_CODE=
