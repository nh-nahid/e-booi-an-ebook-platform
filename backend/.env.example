# Application
APP_NAME=eBooi
PORT=5000
NODE_ENV=development

# URLs (no trailing slash)
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Database
MONGO_CONNECTION_STRING=

# JWT & Cookies
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
COOKIE_NAME=
COOKIE_SECRET=

# Cloudinary (book covers, PDFs, avatars)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# EPS (Easy Payment System).
#   development: EPS_BASE_URL=https://sandboxpgapi.eps.com.bd + sandbox credentials
#   production : EPS_BASE_URL=https://pgapi.eps.com.bd + LIVE credentials, NODE_ENV=production
# With NODE_ENV=production the server refuses to use the sandbox URL.
EPS_BASE_URL=https://sandboxpgapi.eps.com.bd
EPS_USERNAME=
EPS_PASSWORD=
EPS_HASH_KEY=
EPS_STORE_ID=
# Optional — only if EPS gave you a separate merchant id
EPS_MERCHANT_ID=
# Guide table says 1 = Web; the guide's sample body uses 10. Change if EPS rejects 1.
EPS_TRANSACTION_TYPE_ID=1

# Live EPS only accepts callback URLs on your registered domain. Set this to the
# public website origin (no trailing slash), e.g. https://ebooi.bd — the website
# forwards /api/v1/payment/eps/* to this backend. Leave empty in development.
PAYMENT_CALLBACK_BASE=

# Google sign-in (Google Cloud Console -> Credentials -> OAuth client ID, type "Web application").
# Authorized redirect URI: <BACKEND_URL>/api/v1/users/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Gmail SMTP)
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Password reset
RESET_PASSWORD_EXPIRE=

# Admin
# Public admin sign-up is OFF by default. Set to "true" only to bootstrap the
# first admin, then remove it. Admins are normally created in the admin panel.
ALLOW_ADMIN_SIGNUP=false
ADMIN_ACCESS_CODE=
