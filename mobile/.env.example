# Base URL of the ebooi backend API (must end with /api/v1).
# Android emulator talking to a backend on your PC:  http://10.0.2.2:5000/api/v1
# Real phone on the same Wi-Fi:                       http://<your-pc-ip>:5000/api/v1
# Production (Render):                                https://<your-service>.onrender.com/api/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api/v1

# Public website, used for the policy pages opened from the profile tab.
EXPO_PUBLIC_SITE_URL=https://ebooi.bd
